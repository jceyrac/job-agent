# Copy this file to .env and fill in your values
# cp .env.example .env

# LLM (scoring, extraction, and CV agent) — provider, model, key, base URL
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1

# Gmail (email digest sender)
GMAIL_FROM=your.address@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# Notification recipient
NOTIFY_TO=your.destination@email.com

# Joplin Web Clipper (optional — for Joplin export)
JOPLIN_TOKEN=your_joplin_token_here

# RapidAPI (optional — for Wellfound scraper, resets 1st of month, 10 calls/month on BASIC)
X_RAPIDAPI_KEY=your_rapidapi_key_here

# Ingestion via API (spec 045) — the platform principal's ingest-only token.
# Create the token once on the host with:
#   python -m scripts.api_token create --name platform-ingest --user platform --scopes ingest
# then paste the printed token here (never commit the real value).
JOB_AGENT_API_TOKEN=your_platform_ingest_token_here
# NOTE: the path switch is the `ingest_via_api` config key (single source of
# truth) — do NOT put INGEST_VIA_API here. The env var is a staging/test
# bootstrap only (consulted only when the config key is absent), and it must not
# appear in verva's .env.

